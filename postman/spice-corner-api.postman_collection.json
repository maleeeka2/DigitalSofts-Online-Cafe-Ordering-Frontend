{
  "info": {
    "name": "Spice Corner API QA Collection",
    "description": "QA API collection covering health, authentication, menu, orders, cart, payments and protected endpoints.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:5000"
    },
    {
      "key": "token",
      "value": ""
    }
  ],
  "item": [
    {
      "name": "Health",
      "item": [
        {
          "name": "Health Check",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/api/health"
          }
        }
      ]
    },
    {
      "name": "Authentication",
      "item": [
        {
          "name": "User Login - Validation",
          "request": {
            "method": "POST",
            "header": [
              {"key": "Content-Type", "value": "application/json"}
            ],
            "body": {
              "mode": "raw",
              "raw": "{\"email\":\"invalid@example.com\",\"password\":\"wrong\"}"
            },
            "url": "{{baseUrl}}/api/auth/login"
          }
        },
        {
          "name": "Admin Login - Invalid Credentials",
          "request": {
            "method": "POST",
            "header": [
              {"key": "Content-Type", "value": "application/json"}
            ],
            "body": {
              "mode": "raw",
              "raw": "{\"username\":\"invalid\",\"password\":\"invalid\"}"
            },
            "url": "{{baseUrl}}/api/admin/login"
          }
        }
      ]
    },
    {
      "name": "Menu",
      "item": [
        {
          "name": "Get Menu",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/api/menu"
          }
        },
        {
          "name": "Create Menu Item - Unauthorized",
          "request": {
            "method": "POST",
            "header": [
              {"key": "Content-Type", "value": "application/json"}
            ],
            "body": {
              "mode": "raw",
              "raw": "{\"name\":\"QA Test Item\",\"description\":\"API test\",\"price\":10,\"category\":\"Test\",\"available\":true}"
            },
            "url": "{{baseUrl}}/api/menu"
          }
        },
        {
          "name": "Invalid Menu Item",
          "request": {
            "method": "PUT",
            "header": [
              {"key": "Content-Type", "value": "application/json"}
            ],
            "body": {
              "mode": "raw",
              "raw": "{\"price\":-10}"
            },
            "url": "{{baseUrl}}/api/menu/invalid-id"
          }
        }
      ]
    },
    {
      "name": "Orders",
      "item": [
        {
          "name": "Create Order - Invalid Quantity",
          "request": {
            "method": "POST",
            "header": [
              {"key": "Content-Type", "value": "application/json"}
            ],
            "body": {
              "mode": "raw",
              "raw": "{\"items\":[{\"quantity\":0}],\"customer\":{\"name\":\"QA\",\"phone\":\"0000000000\"}}"
            },
            "url": "{{baseUrl}}/api/orders"
          }
        },
        {
          "name": "Track Invalid Order",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/api/orders/track/INVALID-ORDER"
          }
        },
        {
          "name": "Admin Orders - Unauthorized",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/api/orders"
          }
        }
      ]
    },
    {
      "name": "Cart",
      "item": [
        {
          "name": "Get Cart - Unauthorized",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/api/cart/get"
          }
        },
        {
          "name": "Save Cart - Unauthorized",
          "request": {
            "method": "POST",
            "header": [
              {"key": "Content-Type", "value": "application/json"}
            ],
            "body": {
              "mode": "raw",
              "raw": "{\"items\":[]}"
            },
            "url": "{{baseUrl}}/api/cart/save"
          }
        }
      ]
    },
    {
      "name": "Payments",
      "item": [
        {
          "name": "Payment Status - Unauthorized",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/api/payments/status/invalid-payment-intent"
          }
        }
      ]
    },
    {
      "name": "Protected Endpoints",
      "item": [
        {
          "name": "Current User - Unauthorized",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/api/auth/me"
          }
        },
        {
          "name": "User Profile - Unauthorized",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/api/users/profile"
          }
        },
        {
          "name": "Rider Profile - Unauthorized",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/api/riders/profile"
          }
        },
        {
          "name": "Deliveries - Unauthorized",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/api/deliveries/my"
          }
        }
      ]
    }
  ]
}
